
        // lilMCR PCSS: cast shadows of the dedicated light (multiply). Inserted by lilMCR_PCSS (add-on).
        Pass
        {
            Name "LILMCR_PCSS_SHADOW"
            Tags {"LightMode" = "ForwardAdd"}

            Stencil
            {
                Ref [_StencilRef]
                ReadMask [_StencilReadMask]
                WriteMask [_StencilWriteMask]
                Comp [_StencilComp]
                Pass [_StencilPass]
                Fail [_StencilFail]
                ZFail [_StencilZFail]
            }
            Cull [_Cull]
            ZClip [_ZClip]
            ZWrite Off
            ZTest LEqual
            ColorMask RGB
            Offset [_OffsetFactor], [_OffsetUnits]
            Blend DstColor Zero
            BlendOp Add

            HLSLPROGRAM
            // Desktop gather needs SM5-class features. Other APIs use Load.
#if defined(SHADER_API_DESKTOP)
            #pragma target 4.5
#else
            #pragma target 3.5
#endif
            #pragma vertex lmpVert
            #pragma fragment lmpFrag
            #pragma multi_compile_fwdadd_fullshadows
            #pragma skip_variants POINT POINT_COOKIE DIRECTIONAL DIRECTIONAL_COOKIE SHADOWS_CUBE SHADOWS_SCREEN SHADOWS_SOFT LIGHTMAP_SHADOW_MIXING SHADOWMASK
            #pragma multi_compile_instancing
            // lilToonMulti: rendering mode (LIL_RENDER) and the alpha mask come from keywords, converted with
            // lil_replace_keywords.hlsl as in lilToon's own Multi passes. Unused by the other variants.
            #pragma shader_feature_local UNITY_UI_ALPHACLIP
            #pragma shader_feature_local UNITY_UI_CLIP_RECT
            #pragma shader_feature_local _COLOROVERLAY_ON
            #if defined(LIL_MULTI)
                #include "Includes/lil_replace_keywords.hlsl"
            #endif

            #define LIL_PASS_FORWARDADD
            #define LILMCR_PCSS_PASS
            #include "Includes/lil_pipeline_brp.hlsl"
            #include "Includes/lil_common.hlsl"
            #include "lilmcr_pcss.hlsl"
            ENDHLSL
        }
