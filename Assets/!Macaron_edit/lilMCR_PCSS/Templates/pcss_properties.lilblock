        //----------------------------------------------------------------------------------------------------------------------
        // lilMCR PCSS (add-on, appended by lilMCR_PCSS/Editor/LilMCRPcssGenerator.cs)
        [HideInInspector] _lilMCRPCSS_Enable ("lilMCR PCSS (set by Setup)", Float) = 0
        _lilMCRPCSS_ShadowColor ("PCSS Shadow Color", Color) = (0.7,0.7,0.7,1)
        _lilMCRPCSS_AlbedoTint ("PCSS Shadow Uses Base Color", Range(0, 1)) = 1
        _lilMCRPCSS_ShadowSaturation ("PCSS Shadow Saturation", Range(0, 3)) = 0.1
        _lilMCRPCSS_Strength ("PCSS Shadow Strength", Range(0, 1)) = 1
        _lilMCRPCSS_BackShadow ("PCSS Shadow On Back Faces", Range(0, 1)) = 1
        _lilMCRPCSS_LightSize ("Light Size (m)", Range(0, 0.5)) = 0.005
        _lilMCRPCSS_BlockerRange ("Blocker Search Range (m)", Range(0.05, 1.5)) = 0.5
        _lilMCRPCSS_MinBlur ("Minimum Blur (texels)", Range(0, 32)) = 3
        [IntRange] _lilMCRPCSS_Quality ("PCSS Quality (0 Low - 3 Ultra)", Range(0, 3)) = 1
        _lilMCRPCSS_NormalBias ("Normal Bias (texels)", Range(0, 4)) = 4
        _lilMCRPCSS_DepthBias ("Additional Depth Bias (m; base 0.002)", Range(0, 0.02)) = 0
        _lilMCRPCSS_ConeEdge ("Cone Edge Softness", Range(0.01, 1)) = 0.01
        // PCSS-only receiver mask (main UV, red channel): white = PCSS shadow, black = no PCSS shadow.
        // Independent of Macaron's global mask (which still applies too). Made with the Mask Generator ("PCSS mask").
        [NoScaleOffset] _lilMCRPCSS_Mask ("PCSS Mask", 2D) = "white" {}
        _lilMCRPCSS_MaskAmount ("PCSS Mask Amount", Range(0, 1)) = 1
        [HideInInspector] _lilMCRPCSS_Reach ("Dedicated Light Reach (m)", Float) = 4
        [HideInInspector] _lilMCRPCSS_LightId ("Dedicated Light ID", Float) = 0
        [HideInInspector] _lilMCRPCSS_MaxLevel ("Dedicated Light Max Level", Float) = 0.0005

        [ToggleUI] _lilMCRPCSS_SelfOnly ("Self Shadow Only", Float) = 1
        [HideInInspector] _lilMCRPCSS_Projection ("Caster Projection Signature", Vector) = (0,0,0,0)
